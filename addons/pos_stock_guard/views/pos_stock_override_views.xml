<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_stock_override_view_list" model="ir.ui.view">
        <field name="name">pos.stock.override.list</field>
        <field name="model">pos.stock.override</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="not success and not offline" decoration-warning="offline">
                <field name="create_date" string="Date"/>
                <field name="config_id"/>
                <field name="session_id" optional="hide"/>
                <field name="product_id"/>
                <field name="qty_available"/>
                <field name="qty_requested"/>
                <field name="cashier"/>
                <field name="employee_id"/>
                <field name="success"/>
                <field name="offline"/>
            </list>
        </field>
    </record>

    <record id="pos_stock_override_view_search" model="ir.ui.view">
        <field name="name">pos.stock.override.search</field>
        <field name="model">pos.stock.override</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="employee_id"/>
                <filter name="authorized" string="Authorized" domain="[('success', '=', True)]"/>
                <filter name="failed" string="Failed PIN"
                        domain="[('success', '=', False), ('offline', '=', False)]"/>
                <filter name="offline" string="Sold offline" domain="[('offline', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="pos_stock_override_action" model="ir.actions.act_window">
        <field name="name">Out-of-stock authorizations</field>
        <field name="res_model">pos.stock.override</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="pos_stock_override_menu"
              name="Out-of-stock authorizations"
              parent="point_of_sale.menu_point_rep"
              action="pos_stock_override_action"
              groups="point_of_sale.group_pos_manager"
              sequence="90"/>
</odoo>
