#. module: pos_stock_guard
#: model:ir.model.fields,help:pos_stock_guard.field_pos_stock_override__offline
msgid ""
"Sold while the point of sale had no connection: checked only against the "
"last stock the till had downloaded, without a manager PIN. Review and "
"recount."
msgstr "Vendido mientras el punto de venta no tenía conexión: solo se comparó con el último stock que la caja había descargado, sin PIN de encargado. Revísalo y vuelve a contar."

#. module: pos_stock_guard
#. odoo-javascript
#: code:addons/pos_stock_guard/static/src/pos_store_patch.js:0
msgid ""
"The point of sale is offline, so the manager PIN cannot be checked. Try "
"again when the connection is back."
msgstr "El punto de venta está sin conexión, así que no se puede comprobar el PIN del encargado. Inténtalo de nuevo cuando vuelva la conexión."

#. module: pos_stock_guard
#. odoo-javascript
