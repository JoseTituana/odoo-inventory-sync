#. odoo-python
#: code:addons/pos_stock_guard/models/pos_config.py:0
msgid "Too many wrong PINs. Wait 10 minutes and try again."
msgstr "Demasiados PIN incorrectos. Espera 10 minutos e inténtalo de nuevo."

#. module: pos_stock_guard
#. odoo-python
