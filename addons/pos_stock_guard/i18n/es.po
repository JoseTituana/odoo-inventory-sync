#. module: pos_stock_guard
#. odoo-javascript
#: code:addons/pos_stock_guard/static/src/pos_store_patch.js:0
msgid ""
"%(product)s: the last stock this till downloaded is %(stock)s and this order"
" needs %(qty)s. Without a connection a manager PIN cannot be checked, so "
"this cannot be sold until the connection is back."
msgstr "%(product)s: el último stock que descargó esta caja es %(stock)s y esta venta necesita %(qty)s. Sin conexión no se puede comprobar el PIN de un encargado, así que no se puede vender hasta que vuelva la conexión."

#. module: pos_stock_guard
#. odoo-javascript
#: code:addons/pos_stock_guard/static/src/pos_store_patch.js:0
msgid ""
"%(product)s: the system has %(stock)s in stock and this order needs %(qty)s."
" A manager PIN is required to sell it."
msgstr "%(product)s: el sistema tiene %(stock)s en stock y esta venta necesita %(qty)s. Para venderlo hace falta el PIN de un encargado."

