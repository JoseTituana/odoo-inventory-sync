<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_l10n_ec" model="ir.ui.view">
        <field name="name">pos.payment.method.form.l10n_ec_pos_sri</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ec_sri_payment_id" options="{'no_create': True}"
                       invisible="company_id.country_code != 'EC'"/>
            </field>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_l10n_ec" model="ir.ui.view">
        <field name="name">pos.payment.method.list.l10n_ec_pos_sri</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="l10n_ec_sri_payment_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
